<configuration>
  <springProperty scope="context" name="appEnvironment" source="app.environment" defaultValue="development" />
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
      <customFields>{"service":"commercehub-api","environment":"${appEnvironment}"}</customFields>
    </encoder>
  </appender>
  <root level="INFO">
    <appender-ref ref="CONSOLE" />
  </root>
</configuration>
